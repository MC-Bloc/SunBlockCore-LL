CONTROLLER_PORT=/dev/ttyACM0
CONTROLLER_SLAVE=1

DATA_DIRECTORY=            # required — path to the directory for DB files and logs (e.g. /opt/sunblock/data)
POWER_DRAW_SCRIPT_ADDR=    # optional — path to power draw measurement script

DATA_MAN=true
READ_INTERVAL=1            # polling interval in seconds
PORT=3707

# Set to true to run without hardware — generates realistic solar data from real baselines.
# Hardware-specific endpoints (controller params, power profiles) return 503 in this mode.
SIM_MODE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=        # generate with: python3 scripts/gen_password_hash.py
# SECRET_KEY: optional — leave blank and the server generates a random key on
# first run, persisting it to sunblock_settings.db so sessions survive restarts.
# Set it explicitly only if you need the same key across multiple instances.
SECRET_KEY=
TOKEN_EXPIRE_HOURS=24
SECURE_COOKIES=false        # set true if running behind HTTPS

# Secret URL slug for the admin login page — keep this private.
# Bots scan /admin, /login, /dashboard; a random slug is never hit.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(12))"
# If unset, the admin login page is unreachable and a warning is logged at startup.
ADMIN_PATH=                 # e.g. xK9mP3qR7
